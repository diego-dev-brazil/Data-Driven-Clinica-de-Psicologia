        IF (:OLD.HMOD_NOME <> :NEW.HMOD_NOME) OR (:OLD.HMOD_NOME IS NULL AND :NEW.HMOD_NOME IS NOT NULL) OR (:OLD.HMOD_NOME IS NOT NULL AND :NEW.HMOD_NOME IS NULL) THEN
