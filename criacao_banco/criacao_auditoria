--------------------------------------------------------
-- AUDITORIA - CLINICA
-- Tabelas da aplicacao: APP
-- Objetos de auditoria: APP_AUDIT
-- Audita UPDATE e DELETE nas tabelas de historico.
--------------------------------------------------------

--------------------------------------------------------
-- SEQUENCE
--------------------------------------------------------
CREATE SEQUENCE APP_AUDIT.SEQ_AUD
    MINVALUE 1
    MAXVALUE 9999999999999999999999999999
    INCREMENT BY 1
    START WITH 1
    NOCACHE
    ORDER
    NOCYCLE;

--------------------------------------------------------
-- TABELA AUDITORIA
--------------------------------------------------------
CREATE TABLE APP_AUDIT.AUDITORIA (
    AUD_ID            NUMBER NOT NULL,
    AUD_TABELA        VARCHAR2(30) NOT NULL,
    AUD_COLUNA        VARCHAR2(30) NOT NULL,
    AUD_VALOR_ANTIGO  VARCHAR2(4000),
    AUD_VALOR_NOVO    VARCHAR2(4000),
    AUD_TP_OPERACAO   CHAR(1) NOT NULL,
    AUD_DATA_ENTRADA  TIMESTAMP(6) NOT NULL,
    AUD_BD_USER       VARCHAR2(255) NOT NULL,
    AUD_SO_USER       VARCHAR2(255) NOT NULL,
    CONSTRAINT PK_AUD PRIMARY KEY (AUD_ID),
    CONSTRAINT CK_AUD_TP_OPERACAO CHECK (AUD_TP_OPERACAO IN ('U','D'))
);

--------------------------------------------------------
-- PROCEDURE
--------------------------------------------------------
CREATE OR REPLACE PROCEDURE APP_AUDIT.PR_INSERE_AUDITORIA (
    P_TABELA           IN VARCHAR2,
    P_COLUNA           IN VARCHAR2,
    P_VALOR_ANTIGO     IN VARCHAR2,
    P_VALOR_NOVO       IN VARCHAR2,
    P_TP_OPERACAO      IN VARCHAR2,
    P_DATA_ENTRADA     IN TIMESTAMP,
    P_BD_USER          IN VARCHAR2,
    P_SO_USER          IN VARCHAR2
)
IS
BEGIN
    INSERT INTO APP_AUDIT.AUDITORIA (
        AUD_TABELA,
        AUD_COLUNA,
        AUD_VALOR_ANTIGO,
        AUD_VALOR_NOVO,
        AUD_TP_OPERACAO,
        AUD_DATA_ENTRADA,
        AUD_BD_USER,
        AUD_SO_USER
    ) VALUES (
        P_TABELA,
        P_COLUNA,
        P_VALOR_ANTIGO,
        P_VALOR_NOVO,
        P_TP_OPERACAO,
        P_DATA_ENTRADA,
        P_BD_USER,
        P_SO_USER
    );
END;
/

--------------------------------------------------------
-- TRIGGER DA SEQUENCE DA AUDITORIA
--------------------------------------------------------
CREATE OR REPLACE TRIGGER APP_AUDIT.TG_SEQ_AUD
BEFORE INSERT ON APP_AUDIT.AUDITORIA
FOR EACH ROW
BEGIN
    :NEW.AUD_ID := APP_AUDIT.SEQ_AUD.NEXTVAL;
END;
/

--------------------------------------------------------
-- HACOMPANHAMENTOS
--------------------------------------------------------
CREATE OR REPLACE TRIGGER APP_AUDIT.TG_AUD_HACO
BEFORE UPDATE OR DELETE ON APP.HACOMPANHAMENTOS
FOR EACH ROW
DECLARE
    V_TABELA      VARCHAR2(30) := 'HACOMPANHAMENTOS';
    V_USU_BD      VARCHAR2(255) := SYS_CONTEXT('USERENV','SESSION_USER');
    V_USU_SO      VARCHAR2(255) := NVL(SYS_CONTEXT('USERENV','OS_USER'),'NAO_INFORMADO');
    V_TP_OPERACAO CHAR(1);
BEGIN
    IF DELETING THEN
        V_TP_OPERACAO := 'D';
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_ID',TO_CHAR(:OLD.HACO_ID),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_NOME_PACIENTE',:OLD.HACO_NOME_PACIENTE,NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_STATUS',TO_CHAR(:OLD.HACO_STATUS),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DATA_INICIO',TO_CHAR(:OLD.HACO_DATA_INICIO,'YYYY-MM-DD HH24:MI:SS'),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DATA_FIM',TO_CHAR(:OLD.HACO_DATA_FIM,'YYYY-MM-DD HH24:MI:SS'),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_MOT_ID',TO_CHAR(:OLD.HACO_MOT_ID),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_MOD_ID',TO_CHAR(:OLD.HACO_MOD_ID),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DT_ENTRADA',TO_CHAR(:OLD.HACO_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
    ELSE
        V_TP_OPERACAO := 'U';
        IF (:OLD.HACO_ID <> :NEW.HACO_ID) OR (:OLD.HACO_ID IS NULL AND :NEW.HACO_ID IS NOT NULL) OR (:OLD.HACO_ID IS NOT NULL AND :NEW.HACO_ID IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_ID',TO_CHAR(:OLD.HACO_ID),TO_CHAR(:NEW.HACO_ID),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_NOME_PACIENTE <> :NEW.HACO_NOME_PACIENTE) OR (:OLD.HACO_NOME_PACIENTE IS NULL AND :NEW.HACO_NOME_PACIENTE IS NOT NULL) OR (:OLD.HACO_NOME_PACIENTE IS NOT NULL AND :NEW.HACO_NOME_PACIENTE IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_NOME_PACIENTE',:OLD.HACO_NOME_PACIENTE,:NEW.HACO_NOME_PACIENTE,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_STATUS <> :NEW.HACO_STATUS) OR (:OLD.HACO_STATUS IS NULL AND :NEW.HACO_STATUS IS NOT NULL) OR (:OLD.HACO_STATUS IS NOT NULL AND :NEW.HACO_STATUS IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_STATUS',TO_CHAR(:OLD.HACO_STATUS),TO_CHAR(:NEW.HACO_STATUS),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_DATA_INICIO <> :NEW.HACO_DATA_INICIO) OR (:OLD.HACO_DATA_INICIO IS NULL AND :NEW.HACO_DATA_INICIO IS NOT NULL) OR (:OLD.HACO_DATA_INICIO IS NOT NULL AND :NEW.HACO_DATA_INICIO IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DATA_INICIO',TO_CHAR(:OLD.HACO_DATA_INICIO,'YYYY-MM-DD HH24:MI:SS'),TO_CHAR(:NEW.HACO_DATA_INICIO,'YYYY-MM-DD HH24:MI:SS'),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_DATA_FIM <> :NEW.HACO_DATA_FIM) OR (:OLD.HACO_DATA_FIM IS NULL AND :NEW.HACO_DATA_FIM IS NOT NULL) OR (:OLD.HACO_DATA_FIM IS NOT NULL AND :NEW.HACO_DATA_FIM IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DATA_FIM',TO_CHAR(:OLD.HACO_DATA_FIM,'YYYY-MM-DD HH24:MI:SS'),TO_CHAR(:NEW.HACO_DATA_FIM,'YYYY-MM-DD HH24:MI:SS'),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_MOT_ID <> :NEW.HACO_MOT_ID) OR (:OLD.HACO_MOT_ID IS NULL AND :NEW.HACO_MOT_ID IS NOT NULL) OR (:OLD.HACO_MOT_ID IS NOT NULL AND :NEW.HACO_MOT_ID IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_MOT_ID',TO_CHAR(:OLD.HACO_MOT_ID),TO_CHAR(:NEW.HACO_MOT_ID),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_MOD_ID <> :NEW.HACO_MOD_ID) OR (:OLD.HACO_MOD_ID IS NULL AND :NEW.HACO_MOD_ID IS NOT NULL) OR (:OLD.HACO_MOD_ID IS NOT NULL AND :NEW.HACO_MOD_ID IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_MOD_ID',TO_CHAR(:OLD.HACO_MOD_ID),TO_CHAR(:NEW.HACO_MOD_ID),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HACO_DT_ENTRADA <> :NEW.HACO_DT_ENTRADA) OR (:OLD.HACO_DT_ENTRADA IS NULL AND :NEW.HACO_DT_ENTRADA IS NOT NULL) OR (:OLD.HACO_DT_ENTRADA IS NOT NULL AND :NEW.HACO_DT_ENTRADA IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HACO_DT_ENTRADA',TO_CHAR(:OLD.HACO_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),TO_CHAR(:NEW.HACO_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
