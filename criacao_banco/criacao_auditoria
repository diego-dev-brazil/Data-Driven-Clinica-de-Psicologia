CREATE OR REPLACE TRIGGER APP_AUDIT.TG_AUD_HMOT
BEFORE UPDATE OR DELETE ON APP.HMOTIVO_SAIDAS
FOR EACH ROW
DECLARE
    V_TABELA      VARCHAR2(30) := 'HMOTIVO_SAIDAS';
    V_USU_BD      VARCHAR2(255) := SYS_CONTEXT('USERENV','SESSION_USER');
    V_USU_SO      VARCHAR2(255) := NVL(SYS_CONTEXT('USERENV','OS_USER'),'NAO_INFORMADO');
    V_TP_OPERACAO CHAR(1);
BEGIN
    IF DELETING THEN
        V_TP_OPERACAO := 'D';
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_ID',TO_CHAR(:OLD.HMOT_ID),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_NOME',:OLD.HMOT_NOME,NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_DT_ENTRADA',TO_CHAR(:OLD.HMOT_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),NULL,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
    ELSE
        V_TP_OPERACAO := 'U';
        IF (:OLD.HMOT_ID <> :NEW.HMOT_ID) OR (:OLD.HMOT_ID IS NULL AND :NEW.HMOT_ID IS NOT NULL) OR (:OLD.HMOT_ID IS NOT NULL AND :NEW.HMOT_ID IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_ID',TO_CHAR(:OLD.HMOT_ID),TO_CHAR(:NEW.HMOT_ID),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HMOT_NOME <> :NEW.HMOT_NOME) OR (:OLD.HMOT_NOME IS NULL AND :NEW.HMOT_NOME IS NOT NULL) OR (:OLD.HMOT_NOME IS NOT NULL AND :NEW.HMOT_NOME IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_NOME',:OLD.HMOT_NOME,:NEW.HMOT_NOME,V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
        IF (:OLD.HMOT_DT_ENTRADA <> :NEW.HMOT_DT_ENTRADA) OR (:OLD.HMOT_DT_ENTRADA IS NULL AND :NEW.HMOT_DT_ENTRADA IS NOT NULL) OR (:OLD.HMOT_DT_ENTRADA IS NOT NULL AND :NEW.HMOT_DT_ENTRADA IS NULL) THEN
            APP_AUDIT.PR_INSERE_AUDITORIA(V_TABELA,'HMOT_DT_ENTRADA',TO_CHAR(:OLD.HMOT_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),TO_CHAR(:NEW.HMOT_DT_ENTRADA,'YYYY-MM-DD HH24:MI:SS.FF6'),V_TP_OPERACAO,SYSTIMESTAMP,V_USU_BD,V_USU_SO);
        END IF;
    END IF;
END;
