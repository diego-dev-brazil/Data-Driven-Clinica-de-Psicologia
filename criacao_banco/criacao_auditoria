        IF (:OLD.HMOD_DT_ENTRADA <> :NEW.HMOD_DT_ENTRADA) OR (:OLD.HMOD_DT_ENTRADA IS NULL AND :NEW.HMOD_DT_ENTRADA IS NOT NULL) OR (:OLD.HMOD_DT_ENTRADA IS NOT NULL AND :NEW.HMOD_DT_ENTRADA IS NULL) THEN
